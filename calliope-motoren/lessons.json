  "lessons": [
    {
      "id": "kennenlernen",
      "title": "Den Calliope mini kennenlernen",
      "summary": "Ein Rundgang über das Board: Wo ist was?",
      "steps": [
        {
          "camera": "overview",
          "text": "Das ist der Calliope mini 3. Dreh ihn mit der Maus oder dem Finger und schau ihn dir von allen Seiten an."
        },
        {
          "camera": "matrix",
          "highlight": [
            "matrix"
          ],
          "label": [
            "led_r2_c2"
          ],
          "do": {
            "matrix": "heart"
          },
          "text": "In der Mitte sitzt die LED-Matrix: 25 LEDs in 5 Reihen und 5 Spalten. Damit zeigst du Bilder, Zahlen und Text."
        },
        {
          "camera": "buttons",
          "highlight": [
            "button_a",
            "button_b"
          ],
          "label": [
            "button_a",
            "button_b"
          ],
          "do": {
            "matrix": "clear"
          },
          "text": "Links Taste A, rechts Taste B. Mit ihnen gibst du dem Calliope mini Befehle."
        },
        {
          "camera": "rgb",
          "highlight": [
            "rgb_0",
            "rgb_1",
            "rgb_2"
          ],
          "label": [
            "rgb_1"
          ],
          "do": {
            "rgb": "#28c76f"
          },
          "text": "Unter der Matrix sitzen drei RGB-LEDs. Sie können in jeder Farbe leuchten."
        },
        {
          "camera": "grove",
          "highlight": [
            "grove_left",
            "grove_right"
          ],
          "label": [
            "grove_left",
            "grove_right"
          ],
          "do": {
            "rgb": "off"
          },
          "text": "Oben links und rechts sind die Grove-Anschlüsse A0 und A1. Hier steckst du Sensoren und Module mit einem Kabel an."
        },
        {
          "camera": "pins",
          "highlight": [
            "pads"
          ],
          "label": [
            "pad_left",
            "pad_bottom_left",
            "pad_bottom_right",
            "pad_right",
            "pad_top_left",
            "pad_top_right"
          ],
          "text": "Die sechs goldenen Pins am Rand: P0 bis P3 sowie ⊖ (GND, Minus) und ⊕ (3V, Plus). Hier schließt du mit Krokodilklemmen eigene Bauteile an."
        }
      ]
    },
    {
      "id": "tasten",
      "title": "Tasten A und B",
      "summary": "Ein Herz auf Knopfdruck.",
      "steps": [
        {
          "camera": "overview",
          "text": "Rechts siehst du das Programm, das auf dem Calliope mini läuft. Es reagiert auf die Tasten A und B."
        },
        {
          "camera": "button_a",
          "highlight": [
            "button_a"
          ],
          "label": [
            "button_a"
          ],
          "press": "button_a",
          "text": "Drück Taste A: klick sie an oder tippe auf der Tastatur A. Auf der Matrix erscheint ein Herz."
        },
        {
          "camera": "buttons",
          "highlight": [
            "button_b"
          ],
          "label": [
            "button_b"
          ],
          "press": "button_b",
          "text": "Und jetzt Taste B: Der Calliope mini lacht dich an."
        },
        {
          "camera": "overview",
          "text": "Jetzt du: Wähle im Block „wenn Knopf A gedrückt“ ein anderes Symbol oder eine andere Farbe und drück Taste A noch einmal.",
          "blocks": [
            "a_icon",
            "a_col"
          ]
        }
      ],
      "program": [
        {
          "event": "button_a",
          "do": [
            {
              "block": "show_icon",
              "icon": "heart",
              "id": "a_icon"
            },
            {
              "block": "rgb",
              "color": "red",
              "id": "a_col"
            }
          ]
        },
        {
          "event": "button_b",
          "do": [
            {
              "block": "show_icon",
              "icon": "smiley"
            },
            {
              "block": "rgb",
              "color": "orange"
            }
          ]
        }
      ]
    },
    {
      "id": "blinken",
      "title": "Blinken mit Pausen",
      "summary": "Pausenlänge und Farbe selbst einstellen.",
      "program": [
        {
          "event": "start",
          "do": [
            {
              "block": "show_icon",
              "icon": "heart"
            }
          ]
        },
        {
          "event": "forever",
          "do": [
            {
              "block": "rgb",
              "color": "blue",
              "id": "col"
            },
            {
              "block": "pause",
              "ms": 500,
              "id": "p1"
            },
            {
              "block": "rgb_off"
            },
            {
              "block": "pause",
              "ms": 500,
              "id": "p2"
            }
          ]
        }
      ],
      "steps": [
        {
          "camera": "front",
          "highlight": [
            "rgb_0",
            "rgb_1",
            "rgb_2"
          ],
          "text": "Dieses Programm lässt die RGB-LEDs blinken: Farbe an, warten, aus, warten. Der Block „dauerhaft“ wiederholt das immer wieder."
        },
        {
          "camera": "front",
          "blocks": [
            "p1",
            "p2"
          ],
          "text": "Ändere beide Pausen von 500 auf 100 Millisekunden. Wie verändert sich das Blinken?"
        },
        {
          "camera": "front",
          "blocks": [
            "col"
          ],
          "text": "Wähle eine andere Farbe. Die Änderung wird sofort übernommen."
        },
        {
          "camera": "front",
          "blocks": [
            "p1"
          ],
          "text": "Probier unterschiedliche Pausen für an und aus, zum Beispiel 100 und 900. So entsteht ein kurzes Aufblitzen."
        }
      ]
    },
    {
      "id": "led-an-p0",
      "title": "Eine LED an P0 anschließen",
      "summary": "Krokodilklemmen, Pins und Stromkreis.",
      "parts": [
        {
          "id": "led1",
          "type": "led",
          "color": "#ff2a1a",
          "pin": "P0",
          "position": [
            -4.8,
            0,
            2.6
          ]
        }
      ],
      "wires": [
        {
          "id": "w_signal",
          "from": "P0",
          "to": "led1.anode",
          "color": "#d7262e"
        },
        {
          "id": "w_gnd",
          "from": "GND",
          "to": "led1.cathode",
          "color": "#1d1d1f"
        }
      ],
      "steps": [
        {
          "camera": "led_circuit",
          "show": [
            "led1"
          ],
          "highlight": [
            "led1"
          ],
          "text": "Wir brauchen eine LED. Das lange Bein ist der Pluspol (Anode), das kurze der Minuspol (Kathode)."
        },
        {
          "camera": "led_circuit",
          "show": [
            "led1",
            "w_signal"
          ],
          "highlight": [
            "P0"
          ],
          "label": [
            "pad_left"
          ],
          "text": "Klemme das rote Kabel an Pin P0 und an das lange Bein der LED."
        },
        {
          "camera": "led_circuit",
          "show": [
            "led1",
            "w_signal",
            "w_gnd"
          ],
          "highlight": [
            "GND"
          ],
          "label": [
            "pad_top_left"
          ],
          "text": "Das schwarze Kabel kommt an GND und an das kurze Bein. Damit ist der Stromkreis geschlossen."
        },
        {
          "camera": "led_circuit",
          "show": [
            "led1",
            "w_signal",
            "w_gnd"
          ],
          "highlight": [
            "button_a"
          ],
          "label": [
            "button_a"
          ],
          "press": "button_a",
          "text": "Drück Taste A: P0 wird eingeschaltet und die LED leuchtet. Taste B schaltet sie wieder aus.",
          "blocks": [
            "w_on"
          ]
        },
        {
          "camera": "led_circuit",
          "show": [
            "led1",
            "w_signal",
            "w_gnd"
          ],
          "blocks": [
            "w_on"
          ],
          "text": "Stell im Block den Pin auf P1 um und drück A. Die LED bleibt aus, weil das rote Kabel an P0 hängt."
        }
      ],
      "program": [
        {
          "event": "button_a",
          "do": [
            {
              "block": "digital_write",
              "pin": "P0",
              "value": "1",
              "id": "w_on"
            },
            {
              "block": "show_icon",
              "icon": "check"
            }
          ]
        },
        {
          "event": "button_b",
          "do": [
            {
              "block": "digital_write",
              "pin": "P0",
              "value": "0"
            },
            {
              "block": "clear"
            }
          ]
        }
      ]
    },
    {
      "id": "co2-ampel",
      "title": "CO₂-Ampel mit dem SCD40",
      "summary": "Sensor über Grove anschließen und messen.",
      "parts": [
        {
          "id": "scd",
          "type": "model",
          "model": "models/scd40.glb",
          "position": [
            -7.4,
            0,
            -1.6
          ],
          "rotation": 0,
          "scale": 0.1,
          "sockets": {
            "Grove_r": {
              "axis": [
                0,
                0,
                1
              ]
            },
            "Grove_l": {
              "axis": [
                0,
                0,
                1
              ]
            }
          }
        }
      ],
      "wires": [
        {
          "id": "grove1",
          "type": "grove",
          "from": "grove_left",
          "to": "scd.Grove_r"
        }
      ],
      "sensors": {
        "co2": {
          "label": "CO₂ im Raum",
          "unit": "ppm",
          "min": 400,
          "max": 2500,
          "step": 50,
          "value": 650
        }
      },
      "program": [
        {
          "event": "forever",
          "do": [
            {
              "block": "if_co2",
              "threshold": 1000,
              "id": "thr",
              "then": [
                {
                  "block": "rgb",
                  "color": "red",
                  "id": "c_hi"
                },
                {
                  "block": "show_icon",
                  "icon": "sad"
                }
              ],
              "else": [
                {
                  "block": "rgb",
                  "color": "green",
                  "id": "c_lo"
                },
                {
                  "block": "show_icon",
                  "icon": "smiley"
                }
              ]
            },
            {
              "block": "pause",
              "ms": 1000
            }
          ]
        }
      ],
      "steps": [
        {
          "camera": "scd",
          "show": [
            "scd"
          ],
          "label": [
            "scd"
          ],
          "text": "Das ist der SCD40. Er misst den CO₂-Gehalt der Luft, außerdem Temperatur und Luftfeuchtigkeit."
        },
        {
          "camera": "grove_wire",
          "show": [
            "scd",
            "grove1"
          ],
          "highlight": [
            "grove_left"
          ],
          "label": [
            "grove_left"
          ],
          "text": "Verbinde den Sensor mit dem Grove-Kabel mit dem linken Grove-Anschluss A0. Über die vier Adern laufen Strom (rot, schwarz) und Daten (gelb, weiß)."
        },
        {
          "camera": "scd_all",
          "show": [
            "scd",
            "grove1"
          ],
          "label": [
            "scd"
          ],
          "blocks": [
            "thr"
          ],
          "text": "Das Programm ist eine CO₂-Ampel: Über 1000 ppm leuchtet es rot, sonst grün. Verschieb den Regler „CO₂ im Raum“ und beobachte die LEDs."
        },
        {
          "camera": "scd_all",
          "show": [
            "scd",
            "grove1"
          ],
          "label": [
            "scd"
          ],
          "blocks": [
            "thr",
            "c_hi",
            "c_lo"
          ],
          "text": "Ändere den Grenzwert oder die Farben. Ab etwa 1000 ppm sollte man lüften."
        }
      ]
    },
    {
      "id": "ausprobieren",
      "title": "Freies Ausprobieren",
      "summary": "Male eigene Bilder auf die Matrix.",
      "sandbox": true,
      "behavior": [
        {
          "when": "button_a",
          "do": {
            "invert": true
          }
        },
        {
          "when": "button_b",
          "do": {
            "matrix": "clear",
            "rgb": "off"
          }
        }
      ],
      "steps": [
        {
          "camera": "matrix",
          "do": {
            "matrix": "smiley"
          },
          "text": "Klick auf einzelne LEDs, um sie an- und auszuschalten. Taste A dreht das Bild um, Taste B löscht alles."
        }
      ]
    }
  ],
